rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing app collections
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    match /medications/{medId} {
      allow read, write: if true;
    }

    match /appointments/{aptId} {
      allow read, write: if true;
    }

    // Append-only dose logs: client can create, never update or delete
    match /dose_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Append-only activity events: client can create, never update or delete
    match /activity_events/{eventId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // SOS events: client can create, never delete, and may only set resolved_at once
    match /sos_events/{eventId} {
      allow read, create: if true;
      allow update: if resource.data.resolved_at == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved_at'])
        && request.resource.data.resolved_at is string;
      allow delete: if false;
    }
  }
}
